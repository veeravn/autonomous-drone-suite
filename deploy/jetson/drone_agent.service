[Unit]
Description=Autonomous Drone Suite (Production Flight Agent)
After=network-online.target
Wants=network-online.target

# Safety: don't start unless we're in "flight" mode (optional)
# You can comment this out if you don't use this mechanism
ConditionPathExists=/opt/autonomous-drone-suite

[Service]
Type=simple
User=ubuntu
Group=ubuntu

# Where the repo lives in prod
WorkingDirectory=/opt/autonomous-drone-suite

# Environment (optional but useful)
Environment=PROFILE=prod
Environment=PYTHONUNBUFFERED=1

# Activate venv and launch prod profile
ExecStart=/bin/bash -lc 'cd /opt/autonomous-drone-suite && \
  source .venv/bin/activate && \
  exec deploy/jetson/start_agent.sh prod'

Restart=always
RestartSec=5

# Give it a sensible limit; adjust if needed
TimeoutStartSec=60

# Journald logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
